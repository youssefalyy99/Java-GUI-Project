package BackEnd;

import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

/**
 *
 * @author Mega Store
 */
public class DepartmentManager {

    private final ArrayList<Department> departments;
    private final FileHandler fileHandler;
    private EmployeeManager employeeManager;

    public DepartmentManager(ArrayList<Department> departments, FileHandler fileHandler) {
        this.departments = departments;
        this.fileHandler = fileHandler;
    }

    public void setEmployeeManager(EmployeeManager employeeManager) {
        this.employeeManager = employeeManager;
    }
    
    

    public Department findById(int id) {
        for (Department d : departments) {
            if (d.getDepartmentID() == id) {
                return d;
            }
        }
        return null;
    }

    public Department findByName(String name) {
        for (Department d : departments) {
            if (d.getName().equalsIgnoreCase(name)) {
                return d;
            }
        }
        return null;
    }

    public boolean isIdDuplicate(int id) {
        for (Department d : departments) {
            if (d.getDepartmentID() == id) {
                return true;
            }
        }
        return false;
    }

    public ArrayList<Department> getAllDepartments() {
        return new ArrayList<>(departments);
    }

    public boolean isNameDuplicate(String name) {
        for (Department d : departments) {
            if (d.getName().equalsIgnoreCase(name)) {
                return true;
            }
        }
        return false;
    }

    public void save() throws IOException {
        fileHandler.saveDepartments(departments);
    }

    public void load() throws IOException {
        List<Department> loaded = fileHandler.loadDepartments();
        departments.clear();
        if (loaded != null) {
            departments.addAll(loaded);
        }
    }

    public void addDepartment(int id, String name) throws IOException {
        if (name == null || name.trim().isEmpty()) {
            throw new IllegalArgumentException("Department name is required.");
        }
        name = name.trim();
        if (findById(id) != null) {
            throw new IllegalArgumentException("Department ID already exists.");
        }
        if (findByName(name) != null) {
            throw new IllegalArgumentException("Department name already exists.");
        }
        departments.add(new Department(id, name));
        save();
    }

    public void updateDepartment(int id, String newName) throws IOException {

        if (newName == null || newName.trim().isEmpty()) {
            throw new IllegalArgumentException("Department name is required.");
        }
        newName = newName.trim();
        Department d = findById(id);
        if (d == null) {
            throw new IllegalArgumentException("Department not found.");
        }
        Department d2 = findByName(newName);
        if (d2 != null && d2.getDepartmentID() != id) {
            throw new IllegalArgumentException("Department name already exists.");
        }

        d.setName(newName);
        save();
    }

    public void deleteDepartment(int id) throws IOException {
        Department d = findById(id);
        
        if (d == null) {
            throw new IllegalArgumentException("Department not found.   ");
        }
        if (employeeManager!= null && employeeManager.hasEmployeesInDepartment(d)) {
            throw new IllegalArgumentException("Cannot delete a department that still has employees.");
        }
        departments.remove(d);
        save();
    }

}
